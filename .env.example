# ---------------------------------------------------------------------------
# cTrader Open API credentials
# Create an app at https://openapi.ctrader.com/ -> Applications
# ---------------------------------------------------------------------------
CTRADER_APP_ID=your_client_id_here
CTRADER_APP_SECRET=your_client_secret_here

# OAuth2 token for the trading account (scope: trading)
CTRADER_ACCESS_TOKEN=your_access_token_here

# Optional: lets the bot refresh the access token before it expires.
CTRADER_REFRESH_TOKEN=

# ctidTraderAccountId (an integer, NOT the cTrader login number).
CTRADER_ACCOUNT_ID=12345678

# "demo" -> demo.ctraderapi.com | "live" -> live.ctraderapi.com
CTRADER_HOST_TYPE=demo

# ---------------------------------------------------------------------------
# Instruments & schedule
# ---------------------------------------------------------------------------
SYMBOL_WEEKDAY=XAUUSD
SYMBOL_WEEKEND=BTCUSD
# IANA timezone used to decide which weekday it is.
BOT_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Strategy / runtime
# ---------------------------------------------------------------------------
# Seconds between strategy evaluations.
LOOP_INTERVAL_SECONDS=60
# Number of candles pulled per timeframe.
BARS_H4=400
BARS_M15=500
BARS_M5=500

# ---------------------------------------------------------------------------
# Risk management
# ---------------------------------------------------------------------------
RISK_PERCENT=0.5
# Set >0 to bypass percentage sizing and always trade a fixed lot size.
FIXED_VOLUME_LOTS=0
MAX_OPEN_POSITIONS=1
MAX_PENDING_ORDERS=1
# Pending QM limit orders expire after this many minutes (0 = good till cancel).
ORDER_EXPIRY_MINUTES=240

# Safety switch: when false the bot analyses and logs but never sends orders.
ENABLE_TRADING=false

LOG_LEVEL=INFO
