# ---------------------------------------------------------------------------
# cTrader Open API credentials
# Create an app at https://openapi.ctrader.com/ -> Applications
# ---------------------------------------------------------------------------
CTRADER_APP_ID=your_client_id_here
CTRADER_APP_SECRET=your_client_secret_here

# OAuth2 token for the trading account (scope: trading)
CTRADER_ACCESS_TOKEN=your_access_token_here

# Optional: lets the bot refresh the access token before it expires.
CTRADER_REFRESH_TOKEN=

# ctidTraderAccountId (an integer, NOT the cTrader login number).
CTRADER_ACCOUNT_ID=12345678

# "demo" -> demo.ctraderapi.com | "live" -> live.ctraderapi.com
CTRADER_HOST_TYPE=demo

# ---------------------------------------------------------------------------
# Instruments & schedule
# ---------------------------------------------------------------------------
SYMBOL_WEEKDAY=XAUUSD
SYMBOL_WEEKEND=BTCUSD
# IANA timezone used to decide which weekday it is.
BOT_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Strategy / runtime
# ---------------------------------------------------------------------------
# Seconds between strategy evaluations.
LOOP_INTERVAL_SECONDS=60
# Number of candles pulled per timeframe.
BARS_H4=400
BARS_M15=500
BARS_M5=500

# ---------------------------------------------------------------------------
# Risk management
# ---------------------------------------------------------------------------
# Percent of account balance risked per trade, via the distance to the stop.
RISK_PERCENT=2.5
# Set >0 to bypass percentage sizing and always trade a fixed lot size.
FIXED_VOLUME_LOTS=0
MAX_OPEN_POSITIONS=1
MAX_PENDING_ORDERS=1
# Pending QM limit orders expire after this many minutes (0 = good till cancel).
ORDER_EXPIRY_MINUTES=240

# Safety switch: when false the bot analyses and logs but never sends orders.
ENABLE_TRADING=false

# Cancel resting orders on startup. The QM behind each order is tracked in
# memory, so after a restart the bot cannot invalidate or replace them and a
# stale order blocks new setups. Set false only if you place orders by hand
# on these instruments and want them left alone.
CANCEL_ORPHANED_ORDERS_ON_BOOT=true

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Gold session window (fallback when the broker sends no trading schedule)
# Defined in a market timezone so daylight saving is handled automatically:
# Sunday 18:00 -> Friday 17:00 New York = 22:00 UTC summer / 23:00 UTC winter.
# XAUUSD is traded whenever this session is open; BTCUSD only fills the gap.
# ---------------------------------------------------------------------------
GOLD_SESSION_TIMEZONE=America/New_York
GOLD_SESSION_OPEN=SUN 18:00
GOLD_SESSION_CLOSE=FRI 17:00

# HAPI 1 also requires price to be AT the H4 zone the bias wants
# (supply for sells, demand for buys). Set false to trade on H4 trend alone.
REQUIRE_H4_ZONE_PROXIMITY=true
H4_ZONE_PROXIMITY_ATR=1.5

# ---------------------------------------------------------------------------
# Macroeconomic news filter
# Blocks new entries and cancels pending limit orders around high-impact
# releases. Source: Forex Factory's weekly calendar export, which is rate
# limited to 2 downloads per 5 minutes -- keep NEWS_REFRESH_MINUTES well above
# that. Calendars are published days ahead, so an hour-old copy is fine.
#
# Fail-safe: if the feed cannot be read, the bot keeps using the last good
# calendar while it is younger than NEWS_CACHE_MAX_AGE_HOURS. With no usable
# copy at all it blocks new entries rather than trading blind.
# ---------------------------------------------------------------------------
NEWS_FILTER_ENABLED=true
NEWS_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Comma-separated currency codes to watch.
NEWS_CURRENCIES=USD
# High | Medium | Low -- events at or above this impact trigger a blackout.
NEWS_MIN_IMPACT=High
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=30
NEWS_REFRESH_MINUTES=60
NEWS_CACHE_MAX_AGE_HOURS=24
NEWS_REQUEST_TIMEOUT=15
# All-day / tentative entries carry no release time, so they are skipped.
NEWS_BLOCK_ALL_DAY_EVENTS=false

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# Leave either value blank to disable: the bot logs that notifications are
# inactive and carries on trading normally.
#
# Get a token from @BotFather. For the chat id, message your bot once then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id (negative for groups).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set false to silence notifications without removing the credentials.
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT=10

# ---------------------------------------------------------------------------
# Counter-trend scalps
# HAPI 1 normally permits only trades aligned with the H4 bias. Set true to
# also allow the opposite direction -- a SELL under a bullish H4, or a BUY
# under a bearish one. Higher risk by design.
#
# A counter-trend setup additionally REQUIRES AO divergence on M15 or M5:
# with the trend divergence is a warning, against it it is the whole
# justification. A ranging H4 still blocks both directions.
# ---------------------------------------------------------------------------
ALLOW_COUNTER_TREND=false
